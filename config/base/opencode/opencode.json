{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": ["~/.codex/AGENTS.md"],
  "lsp": true,
  "provider": {
    "alibaba-bailian-internal-dev": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Alibaba Cloud Model Studio - internal dev",
      "options": {
        "baseURL": "{env:ALIBABA_BAILIAN_INTERNAL_DEV_BASE_URL}",
        "apiKey": "{env:ALIBABA_BAILIAN_INTERNAL_DEV_API_KEY}"
      },
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max"
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus"
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "glm-5.2": {
          "name": "GLM-5.2"
        },
        "MiniMax-M2.5": {
          "name": "MiniMax M2.5"
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    },
    "token-factory": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Token Factory",
      "options": {
        "baseURL": "https://proxy.token-factory.digicore-ai.com/v1",
        "apiKey": "{env:TF_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    }
  }
}
